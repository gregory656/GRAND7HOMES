# Environment Variables Template
# Copy this file to .env and fill in your values
# These API keys will be added later when available

# API Base URL
VITE_API_URL=http://localhost:3000/api

# Stripe Payment Keys (will be added when Stripe account is set up)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# PayPal Integration Keys (will be added when PayPal account is set up)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Cloudinary Image Upload Keys (will be added when Cloudinary account is set up)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Google Maps API Key (for location map display)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
